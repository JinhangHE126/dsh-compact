{
  "name": "dsh-compaction-rolling",
  "version": "0.1.0",
  "description": "Rolling-merge compaction backend for DeepSeek Harness — drop-in replacement for @deepseek-ai/dsh-compaction-basic (port of dsh-compact engine prompts).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.yml",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinhangHE126/dsh-compact.git",
    "directory": "plugin/dsh-compaction-rolling"
  },
  "homepage": "https://github.com/JinhangHE126/dsh-compact/tree/feat/dsh-compaction-backend/plugin/dsh-compaction-rolling",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "compaction",
    "context",
    "rolling-merge",
    "summarization"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-compaction": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-compaction-basic": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.3",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  }
}
